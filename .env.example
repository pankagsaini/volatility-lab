# Profiles: local, test, staging, production. Export settings or name this file using VOL_LAB_ENV_FILE.
VOL_LAB_ENV=local
VOL_LAB_LOG_LEVEL=INFO
VOL_LAB_OFFLINE=false
STREAMLIT_SERVER_PORT=8501
# Optional absolute paths to runtime storage and a read-only broker archive.
VOL_LAB_DATA_DIR=
VOL_LAB_ARCHIVE_DIR=
# Optional overrides. Keep tokens outside version control.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
UPSTOX_TOKEN=
