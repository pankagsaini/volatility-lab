# Volatility Lab – Environment & Secrets Configuration Template
# Copy this file to .env for local overrides (never commit .env to version control)

# --- Upstox API Credentials ---
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8501"
UPSTOX_ACCESS_TOKEN=""

# --- Google Cloud & Apps Script Sync ---
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbz_SAMPLE/exec"
WEBHOOK_KEY=""

# --- Operational Settings ---
PORT=8501
VOL_LAB_ENV="development" # development | production | offline
MAX_WORKERS=2
MALLOC_TRIM_THRESHOLD_=65536
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
