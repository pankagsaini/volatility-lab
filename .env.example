# Volatility Lab – Environment & Secrets Configuration Template
# Copy this file to .env for local overrides (never commit real .env secrets to version control)

# --- Streamlit Runtime Config ---
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
PORT=8501

# --- Upstox API Credentials ---
UPSTOX_TOKEN=""
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8501"
UPSTOX_ACCESS_TOKEN=""

# --- Google Cloud & Apps Script Sync ---
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbz_SAMPLE/exec"
WEBHOOK_KEY=""

# --- Domain & Deployment Values ---
CNAME_DOMAIN=volatilitylab.in

# --- Operational & Memory Settings ---
VOL_LAB_ENV="development" # development | production | offline
MAX_WORKERS=2
MALLOC_TRIM_THRESHOLD_=65536
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
