# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Embedded Python Runtime & MinGit Binary Tools
Volatility Lab/.runtime/
Volatility Lab/.dependencies/

# Encrypted Auth Credentials & Token Storage
Volatility Lab/.auth/
.streamlit/secrets.toml
Volatility Lab/.streamlit/secrets.toml
*.bin
*.lock
*.tmp
.clasprc.json
.clasp.json

# System Diagnostic Logs
Volatility Lab/logs/
*.log

# Large Market Data Files & Binary Databases
*.sqlite*
Volatility Lab/*.sqlite*
Volatility Lab/data/backtest_1minute/*.json.gz
Volatility Lab/data/backtest_1minute/*.sqlite*
Volatility Lab/data/backtest_futures/*.json.gz
Volatility Lab/data/google_archive/*.json.gz
Volatility Lab/data/quote_archive/
Volatility Lab/data/quote_quality/
Volatility Lab/data/underlying_history/
Volatility Lab/data/dividend_sources/*.pdf
Volatility Lab/data/*.sqlite*
Volatility Lab/data/**/*.sqlite*
# Node / Frontend Dependencies
node_modules/
**/node_modules/
.npm/
Volatility Lab/frontend/node_modules/
Volatility Lab/web/plotly.min.js

# Data subdirectories to ignore
Volatility Lab/data/upstox/chains/
Volatility Lab/data/upstox/catalogues/
Volatility Lab/data/experiments/
Volatility Lab/data/validation/
Volatility Lab/data/input_history/
Volatility Lab/data/exports/
Volatility Lab/data/futures/
Volatility Lab/data/research_inputs/
