!volatility_lab/data/backtest_futures/scope.json
volatility_lab/data/google_archive/
!volatility_lab/data/google_archive/*.json

# Explicitly Keep Tracking Metadatas, Baseline Quotes, and Historical Prices
!volatility_lab/data/*.json
!volatility_lab/data/*.csv
!volatility_lab/data/dividend_sources/*.txt

# Charges: Track active Upstox fee schedules only; ignore dated daily scrapes and legacy brokers
volatility_lab/data/charges/*
!volatility_lab/data/charges/upstox/
volatility_lab/data/charges/upstox/*
!volatility_lab/data/charges/upstox/current.json
!volatility_lab/data/charges/upstox/check_status.json

# Upstox: Track contract lists & master catalogue; ignore transient event feeds and diagnostics
volatility_lab/data/upstox/*
!volatility_lab/data/upstox/master.json
!volatility_lab/data/upstox/NIFTY_expiries.json
!volatility_lab/data/upstox/BANKNIFTY_expiries.json

# Ignore ephemeral backtest runs and daily collector logs
volatility_lab/data/backtest_runs/
volatility_lab/data/daily_collector/
volatility_lab/data/audit/
volatility_lab/data/audit/**
