!Volatility Lab/data/daily_collector/*.jsonl
!Volatility Lab/data/dividend_sources/*.txt
!Volatility Lab/data/upstox/*.json
!Volatility Lab/data/upstox/*.jsonl
!Volatility Lab/data/backtest_runs/
!Volatility Lab/data/backtest_runs/*.json

# Exclude all databases, large audit archives, and temp files regardless of directory
*.sqlite*
**/*.sqlite*
!Volatility Lab/data/monitor.sqlite
*.lock
*.tmp
Volatility Lab/data/audit/
Volatility Lab/data/audit/**
