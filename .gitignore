# Backups, Scratch & Temporary Fixes
.audit_backups/
scratch/
apply_volatility_lab_fixes.py
*.bak
*.orig

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/
*.egg
build/
dist/

# Windows Batch & Untracked Shell Scripts
*.cmd
*.ps1

# Embedded Python Runtime & MinGit Binary Tools
volatility_lab/.runtime/
volatility_lab/.dependencies/

# Encrypted Auth Credentials, Secrets & Token Storage
volatility_lab/.auth/
.streamlit/secrets.toml
volatility_lab/.streamlit/secrets.toml
*.bin
*.lock
*.tmp
.clasprc.json
.env
.env.*
!.env.example

# System Diagnostic Logs
volatility_lab/logs/
*.log

# Large Market Data Files & Binary Databases
*.sqlite*
**/*.sqlite*
volatility_lab/data/backtest_1minute/*.json.gz
volatility_lab/data/backtest_1minute/*.sqlite*
volatility_lab/data/backtest_futures/*.json.gz
volatility_lab/data/google_archive/*.json.gz
data/google_archive/*.json.gz
data/google_archive/
volatility_lab/data/quote_archive/
volatility_lab/data/quote_quality/
volatility_lab/data/underlying_history/
volatility_lab/data/dividend_sources/*.pdf
volatility_lab/data/*.sqlite*
volatility_lab/data/**/*.sqlite*

# Node / Frontend Dependencies (Legacy)
node_modules/
**/node_modules/
.npm/

# Data subdirectories to ignore
archive_to_verify_before_delete/
volatility_lab/data/upstox/chains/
volatility_lab/data/upstox/catalogues/
volatility_lab/data/experiments/
volatility_lab/data/validation/
volatility_lab/data/input_history/
volatility_lab/data/exports/
volatility_lab/data/futures/
volatility_lab/data/research_inputs/
volatility_lab/data/backtest_1minute/
